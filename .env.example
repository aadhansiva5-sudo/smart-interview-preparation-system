# ============================================================
# Smart Placement Preparation System — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Server ---
PORT=3000

# --- AI / Gemini API Key ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Session Security (CHANGE THIS to a long random string in production) ---
SESSION_SECRET=change_me_to_a_long_random_secret_string_in_production

# ============================================================
# Email / SMTP Configuration (REQUIRED for real OTP delivery)
# ============================================================
# Leave SMTP_HOST / SMTP_USER / SMTP_PASS blank to use DEV MODE:
# in dev mode the OTP is only printed to the server console.
#
# ---- Gmail (recommended for testing) ----
#   1. Enable 2-Step Verification on your Google account
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#   3. Use that 16-char App Password as SMTP_PASS (NOT your login password)
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=your-gmail@gmail.com
#
# ---- SendGrid ----
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_api_key
# EMAIL_FROM=no-reply@yourdomain.com
#
# ---- Mailgun (SMTP) ----
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@mg.yourdomain.com
# SMTP_PASS=your_mailgun_smtp_password
# EMAIL_FROM=no-reply@mg.yourdomain.com
#
# ---- Generic SMTP (any provider) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
